# Frontend Environment Variables for Vercel Deployment
# Copy this to .env.local for development or configure in Vercel dashboard

# Backend API URL - Replace with your Render backend URL
VITE_API_BASE=https://hopx.onrender.com

# Optional: API timeout settings
VITE_API_TIMEOUT=30000

# Optional: Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
